# ===============================================================================
# FILE PURPOSE:
# Example template environment file for the backend.
# Provides placeholder keys for environment variables required by the application
# without revealing actual secrets. Used as a baseline for new developers.
#
# CONNECTED FILES & FOLDERS:
# - Connected to: backend/.env (Copied and populated during initial setup)
# - Connected to: backend/app/config.py (Specifies expected environment fields)
# ===============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/bhojanalay
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXP=10
ADMIN_USERNAME=your_custom_admin_username
ADMIN_PASSWORD=your_custom_admin_password

